<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config permits cleartext as safe fallback -->
    <base-config cleartextTrafficPermitted="true" />

    <!-- Explicitly permit local dev and Cloudflare Quick Tunnels -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">trycloudflare.com</domain>
        <domain includeSubdomains="true">workers.dev</domain>
    </domain-config>
</network-security-config>
